   },
   "text": "His diary. Day after day: the itching.\nThe last entry: itchy. itchy. scott came. ugly face so i killed him. tasty"
  },
  {
   "zone": {
    "x0": 4590,
    "z0": 3400,
    "x1": 5610,
    "z1": 4760
   },
   "text": "The lamp's still lit. On the plate, a bone. Gnawed."
  },
  {
   "zone": {
    "x0": 5440,
    "z0": 5355,
    "x1": 8925,
    "z1": 6205
   },
   "text": "The sheets are soaked. Flakes of skin, everywhere.\nHe scratched himself raw."
  },
  {
   "zone": {
    "x0": 7480,
    "z0": 1700,
    "x1": 9180,
    "z1": 2890
   },
   "text": "The water in the basin is pink."
  },
  {
   "zone": {
    "x0": 8160,
    "z0": 4930,
    "x1": 9180,
    "z1": 5780
   },
   "text": "A key on the hook. The tag says BACK GATE."
  },
  {
   "zone": {
    "x0": 1700,
    "z0": 2380,
    "x1": 2720,
    "z1": 5100
   },
   "text": "His tools. Kept clean, oiled. Before."
  },
  {
   "zone": {
    "x0": 1870,
    "z0": 1700,
    "x1": 4420,
    "z1": 2890
   },
   "text": "Seed trays. Everything in them has died."
  },
  {
   "zone": {
    "x0": 6630,
    "z0": 3060,
    "x1": 8330,
    "z1": 4420
   },
   "text": "This is where it happened. Someone called Scott."

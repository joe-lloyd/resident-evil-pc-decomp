   },
   "text": "GATE 7. A steel chain round the gate and its post,\nand a padlock on it."
  },
  {
   "zone": {
    "x0": 14450,
    "z0": 9350,
    "x1": 16150,
    "z1": 11050
   },
   "text": "A ranger's clipboard. The check sheet: GATE 7, CHAINED AND LOCKED, 23 JUL, 18.00.\nHe never came back for it."
  },
  {
   "zone": {
    "x0": 14110,
    "z0": 5950,
    "x1": 15640,
    "z1": 7310
   },
   "text": "A county notice, torn half away.\n...ARKLAY AREA CLOSED UNTIL FURTHER... ...HIKERS... ...DO NOT APPROACH..."
  },
  {
   "zone": {
    "x0": 18700,
    "z0": 5950,
    "x1": 20230,
    "z1": 7650
   },
   "text": "ARKLAY NATIONAL FOREST. FOREST ROAD 7.\nSomeone's used it for target practice."
  },
  {
   "zone": {
    "x0": 17340,
    "z0": 11560,
    "x1": 20060,
    "z1": 13600
   },
   "text": "Glass from a headlamp, and blood. Grey fur.\nSomething big ran out in front of a truck here."
  },
  {
   "zone": {
    "x0": 21760,
    "z0": 5950,
    "x1": 26520,
    "z1": 17850
   },
   "text": "Paw prints, crossing the road. Big ones.\nThe dogs came down this way."
  },
  {
   "zone": {
    "x0": 15300,
    "z0": 16490,
    "x1": 17340,
    "z1": 17850
   },
   "text": "A ranger's hat, in the ditch."
  }
 ],

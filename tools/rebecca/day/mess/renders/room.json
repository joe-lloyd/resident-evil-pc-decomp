   },
   "text": "The cook, in his apron. He died holding the counter.\nThere's a ring of keys on his belt. One is tagged OFFICE."
  },
  {
   "zone": {
    "x0": 5780,
    "z0": 7259,
    "x1": 6800,
    "z1": 8109
   },
   "text": "A meat cleaver. He didn't go down without a fight."
  },
  {
   "zone": {
    "x0": 4760,
    "z0": 3145,
    "x1": 7820,
    "z1": 3910
   },
   "text": "Stew, still simmering on the range. Someone kept the fire going.\nIt doesn't smell like food any more."
  },
  {
   "zone": {
    "x0": 8585,
    "z0": 11220,
    "x1": 9520,
    "z1": 14280
   },
   "text": "A fork, driven into the table. Blood across the boards.\nThey turned on each other over dinner."
  },
  {
   "zone": {
    "x0": 4675,
    "z0": 11220,
    "x1": 5610,
    "z1": 14620
   },
   "text": "Plates of stew, half eaten. Flies."
  },
  {
   "zone": {
    "x0": 1700,
    "z0": 7650,
    "x1": 2720,
    "z1": 9350
   },
   "text": "THURS 23. STEW. BREAD. NO SECONDS.\nYesterday."
  },
  {
   "zone": {
    "x0": 3230,
    "z0": 6970,
    "x1": 4250,
    "z1": 7820
   },
   "text": "The serving hatch. The kitchen's through there."

 "checks": [
  {
   "zone": {
    "x0": 6885,
    "z0": 4420,
    "x1": 8160,
    "z1": 5610
   },
   "text": "The radio's still on. Through the hiss, a voice on the police band:\n'...Alpha team will fly the Arklay range at dusk... searching for Bravo...'\nThey're coming. Tonight."
  },
  {
   "zone": {
    "x0": 6885,
    "z0": 3060,
    "x1": 8160,
    "z1": 4420
   },
   "text": "The station log. Every hour, to the minute.\n0815 POLICE BAND. STARS ALPHA TO FLY AT DUSK. ASKED WIND ON RIDGE.\n0840 CROWS AT THE GLASS AGAIN. HUNDREDS.\nHis tea's beside it, cold. A crow came through the window and died on his desk."
  },
  {
   "zone": {
    "x0": 2720,
    "z0": 1700,
    "x1": 4250,
    "z1": 2805
   },
   "text": "A barograph. The pen is still drawing.\nThe pressure's falling."
  },
  {
   "zone": {
    "x0": 1700,
    "z0": 3060,
    "x1": 3230,
    "z1": 5610
   },
   "text": "His bed. Unmade. A photo of a woman by the pillow."
  },
  {
   "zone": {
    "x0": 2040,
    "z0": 5950,
    "x1": 3910,
    "z1": 6800
   },
   "text": "His coat's still on the hook. Wherever he went, he went in a hurry."
  },
  {
   "zone": {
    "x0": 5610,
    "z0": 3230,
    "x1": 6970,
    "z1": 4420
   },
   "text": "A pencil, dropped on the floor."
  },
  {
   "zone": {
    "x0": 6630,
    "z0": 5950,
    "x1": 8160,
    "z1": 6800
   },
   "text": "July. Every day crossed off up to yesterday."
  }
 ],

 "checks": [
  {
   "zone": {
    "x0": 11560,
    "z0": 28900,
    "x1": 14960,
    "z1": 30600
   },
   "text": "CAMP 4. QUARANTINE. BY ORDER.\nPainted by hand. The paint ran before it dried."
  },
  {
   "zone": {
    "x0": 17000,
    "z0": 24480,
    "x1": 21760,
    "z1": 27540
   },
   "text": "A logger, face down in the mud. A peavey is driven into his back.\nThat wasn't done by anything sick."
  },
  {
   "zone": {
    "x0": 12920,
    "z0": 11900,
    "x1": 17680,
    "z1": 16320
   },
   "text": "They burned something here. Mattress springs. And bones.\nOne log is still smoking."
  },
  {
   "zone": {
    "x0": 17680,
    "z0": 2890,
    "x1": 18700,
    "z1": 4420
   },
   "text": "A fire axe, buried in the door. Someone was holding it shut from inside."
  },
  {
   "zone": {
    "x0": 23120,
    "z0": 9520,
    "x1": 26860,
    "z1": 12240
   },
   "text": "He sat down against the logs with a shotgun and fired until it was empty.\nShells everywhere."
  },
  {
   "zone": {
    "x0": 4420,
    "z0": 17680,
    "x1": 8160,
    "z1": 21760
   },
   "text": "Two men under canvas, laid out straight. Someone still cared, at first."
  },
  {
   "zone": {
    "x0": 4420,
    "z0": 11560,
    "x1": 6460,
    "z1": 13600
   },
   "text": "The cookhouse bell. The rope's been cut short."
  },
  {
   "zone": {
    "x0": 17680,
    "z0": 20060,
    "x1": 19040,
    "z1": 24140
   },
   "text": "The skidder. Its blade is down in the mud, the chokers still on the logs.\nThe key's gone."
  },
  {
   "zone": {
    "x0": 9520,
    "z0": 4420,
    "x1": 16660,
    "z1": 6800
   },
   "text": "Laundry on the line. Nobody's coming for it."
  },
  {
   "zone": {
    "x0": 26860,
    "z0": 19720,
    "x1": 30600,
    "z1": 23120
   },
   "text": "Diesel, leaking from a drum into the mud."
  }
 ],
 "items": [],
 "spots": [],
 "entry": "Camp 4. The gate was shut from inside.",
 "notes": [
  "from the gate: the body in the mud, the skidder, the fire pit, the bunkhouse beyond",
  "from by the office: the fire pit, the skidder's blade, the workshop door",
  "from the ruts: the sawmill's open doors, the log deck, the dead man against it",
  "from the bell post: the laundry, the bunkhouse door with the axe in it",
  "from the fire pit: the office door in the corner, the bell post, the laundry",
  "from the ruts: the mess door, the bell, the two under canvas",
  "from inside the gate: the depot gate, the choked logs, the board",
  "from the fire pit: the workshop door, the leaking drums, the mill doors"
 ]

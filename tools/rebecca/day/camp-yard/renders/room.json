  {
   "zone": {
    "x0": 18020,
    "z0": 24820,
    "x1": 22780,
    "z1": 27540
   },
   "text": "A log on the sawhorses, cut halfway through.\nThe chainsaw's still sitting on it."
  },
  {
   "zone": {
    "x0": 12920,
    "z0": 11900,
    "x1": 17680,
    "z1": 16320
   },
   "text": "Someone was burned here. What's left is curled up black in the ash.\nIt's still smoking."
  },
  {
   "zone": {
    "x0": 17680,
    "z0": 2890,
    "x1": 18700,
    "z1": 4420
   },
   "text": "A fire axe, buried in the door. Someone was holding it shut from inside."
  },
  {
   "zone": {
    "x0": 23120,
    "z0": 9520,
    "x1": 26860,
    "z1": 12240
   },
   "text": "He sat down against the logs with a shotgun and fired until it was empty.\nShells everywhere."
  },
  {
   "zone": {
    "x0": 3740,
    "z0": 17340,
    "x1": 5440,
    "z1": 22780
   },
   "text": "The cookhouse woodpile. Split and stacked, enough for weeks."
  },
  {
   "zone": {
    "x0": 4420,
    "z0": 11560,
    "x1": 6460,
    "z1": 13600
   },
   "text": "The cookhouse bell. The rope's been cut short."
  },
  {
   "zone": {
    "x0": 17680,
    "z0": 20060,
    "x1": 19040,
    "z1": 24140
   },
   "text": "The skidder. Its blade is down in the mud, the chokers still on the logs.\nThe key's gone."
  },
  {
   "zone": {
    "x0": 9520,
    "z0": 4420,
    "x1": 16660,
    "z1": 6800
   },
   "text": "Laundry on the line. Nobody's coming for it."
  },
  {
   "zone": {
    "x0": 26860,
    "z0": 19720,
    "x1": 30600,
    "z1": 23120
   },
   "text": "Diesel, leaking from a drum into the mud."
  },
  {
   "zone": {
    "x0": 3740,
    "z0": 23800,
    "x1": 8160,
    "z1": 24820
   },
   "text": "The fuel depot. The gate's chained shut, a padlock on it."
  }
 ],

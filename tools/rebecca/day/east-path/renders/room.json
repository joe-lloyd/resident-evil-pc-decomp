 "entry": null,
 "notes": [
  "from the west end by the fence: the path in, the thermos, the cottage set back",
  "from the north-east corner: the drips going on east, the windsock, the bench and the valley",
  "from the fence below the cottage: its front, the open door, the hand on the frame",
  "from beside the woodpile: the length of the path east toward the quarry"
 ]

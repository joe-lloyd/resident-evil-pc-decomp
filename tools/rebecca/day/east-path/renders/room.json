 "checks": [
  {
   "zone": {
    "x0": 6290,
    "z0": 11220,
    "x1": 8840,
    "z1": 13770
   },
   "text": "A thermos, dropped on the path. The coffee's long dried.\nThe cup rolled off into the grass."
  },
  {
   "zone": {
    "x0": 10200,
    "z0": 10540,
    "x1": 13940,
    "z1": 12580
   },
   "text": "Blood, drop after drop, from the station. He was bleeding as he walked."
  },
  {
   "zone": {
    "x0": 13770,
    "z0": 7055,
    "x1": 14620,
    "z1": 8160
   },
   "text": "A bloody hand on the door frame. He went in."
  },
  {
   "zone": {
    "x0": 24480,
    "z0": 11560,
    "x1": 27540,
    "z1": 13940
   },
   "text": "A rag soaked in blood. The drips go on, east.\nHe came out again and kept going."
  },
  {
   "zone": {
    "x0": 20230,
    "z0": 8500,
    "x1": 22610,
    "z1": 10710
   },
   "text": "SKYWAY back the way I came. QUARRY and OLD MINE on ahead.\nThere's blood on the post."
  },
  {
   "zone": {
    "x0": 6800,
    "z0": 17850,
    "x1": 10200,
    "z1": 20400
   },
   "text": "A bench with a view of the whole valley. A little plaque:\nFOR THE ONES WHO BUILT THE SKYWAY."
  },
  {
   "zone": {
    "x0": 23460,
    "z0": 17000,
    "x1": 26180,
    "z1": 19720
   },
   "text": "The station's windsock. It's blowing hard off the valley."
  },
  {
   "zone": {
    "x0": 8500,
    "z0": 7140,
    "x1": 10540,
    "z1": 9180
   },
   "text": "The axe is still in the block. Somebody's woodpile, somebody's washing."
  }
 ],

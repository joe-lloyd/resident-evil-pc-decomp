 "checks": [
  {
   "zone": {
    "x0": 17680,
    "z0": 9690,
    "x1": 21420,
    "z1": 10710
   },
   "text": "A pickup, nose-down in the gully. ARKLAY TIMBER CO., CAMP 4.\nHe drove straight through the barrier in the dark."
  },
  {
   "zone": {
    "x0": 12920,
    "z0": 9690,
    "x1": 17680,
    "z1": 10710
   },
   "text": "Down in the pool, face down. A logger, in his orange vest.\nHe got out of the truck, and no further."
  },
  {
   "zone": {
    "x0": 14960,
    "z0": 5100,
    "x1": 19040,
    "z1": 6800
   },
   "text": "The culvert's choked with branches. The creek's coming over the road instead."
  },
  {
   "zone": {
    "x0": 22440,
    "z0": 8500,
    "x1": 27880,
    "z1": 13600
   },
   "text": "A ROAD CLOSED barrier, smashed to pieces."
  },
  {
   "zone": {
    "x0": 7140,
    "z0": 19040,
    "x1": 10880,
    "z1": 19890
   },
   "text": "The generator's fuel tank. The gauge reads empty.\nI knock on it. Hollow."
  },
  {
   "zone": {
    "x0": 3060,
    "z0": 15470,
    "x1": 5780,
    "z1": 17170
   },
   "text": "A snake's shed skin, on the warm stone.\nAdders. I'll keep out of the long grass."
  },
  {
   "zone": {
    "x0": 1700,
    "z0": 13090,
    "x1": 3740,
    "z1": 14790
   },
   "text": "FIRE LOOKOUT. The track climbs west, to the tower."
  }
 ],

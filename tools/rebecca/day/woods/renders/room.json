 "checks": [
  {
   "zone": {
    "x0": 4930,
    "z0": 15300,
    "x1": 6970,
    "z1": 17510
   },
   "text": "Rifle brass, a handful of it. He stood here and kept shooting."
  },
  {
   "zone": {
    "x0": 4420,
    "z0": 13260,
    "x1": 6630,
    "z1": 15300
   },
   "text": "The needles are soaked here. This is where they got him down."
  },
  {
   "zone": {
    "x0": 10030,
    "z0": 10370,
    "x1": 11900,
    "z1": 12070
   },
   "text": "His flashlight. It's still on, just. The battery's nearly gone."
  },
  {
   "zone": {
    "x0": 12750,
    "z0": 9180,
    "x1": 14620,
    "z1": 10880
   },
   "text": "One of his boots, the laces still done up.\nHe caught his heel on the root, and they pulled him out of it."
  },
  {
   "zone": {
    "x0": 11560,
    "z0": 6800,
    "x1": 13430,
    "z1": 8330
   },
   "text": "A strip of khaki on a dead branch, the same as his shirt."
  },
  {
   "zone": {
    "x0": 13260,
    "z0": 5100,
    "x1": 16320,
    "z1": 7820
   },
   "text": "Paw prints either side of the smear. Big ones.\nThey dragged him north, into the hollow."
  },
  {
   "zone": {
    "x0": 20400,
    "z0": 7820,
    "x1": 23970,
    "z1": 11050
   },
   "text": "A deer. They ate her soft parts first.\nShe's been here longer than he has."
  },
  {
   "zone": {
    "x0": 28220,
    "z0": 19890,
    "x1": 30600,
    "z1": 22440
   },
   "text": "Orange paint on the bark, and a 4. A tree marked for felling.\nThe logging camp must be that way."
  }
 ],
 "entry": "The drag marks go on into the trees. So does the blood.",
 "notes": [
  "from the south-west: the drag in from the yard, the flashlight, the way north",
  "from the north edge looking back: the boot, the smear swinging round the blowdown",
  "from the north-east: the doe and her flies, the blowdown, the drag beyond",
  "from by the doe, south-east: over the blowdown to the ruts and the way out east",
  "from the north-west over the old blowdown: the casings, the drag in, the doe far off"
 ]

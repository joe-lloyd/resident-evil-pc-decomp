 "checks": [
  {
   "zone": {
    "x0": 4930,
    "z0": 15300,
    "x1": 6970,
    "z1": 17510
   },
   "text": "Rifle brass, a handful of it. He stood here and kept shooting."
  },
  {
   "zone": {
    "x0": 4420,
    "z0": 13260,
    "x1": 6630,
    "z1": 15300
   },
   "text": "The needles are soaked here. This is where they got him down."
  },
  {
   "zone": {
    "x0": 10030,
    "z0": 10370,
    "x1": 11900,
    "z1": 12070
   },
   "text": "His flashlight. It's still on, just. The battery's nearly gone."
  },
  {
   "zone": {
    "x0": 12580,
    "z0": 9690,
    "x1": 14450,
    "z1": 11390
   },
   "text": "One of his boots, the laces still done up.\nHe caught his heel on the root, and they pulled him out of it."
  },
  {
   "zone": {
    "x0": 10540,
    "z0": 5950,
    "x1": 12580,
    "z1": 7650
   },
   "text": "A strip of green cloth caught on the log. Forest Service green."
  },
  {
   "zone": {
    "x0": 13260,
    "z0": 5100,
    "x1": 16320,
    "z1": 7650
   },
   "text": "Paw prints either side of the smear. Big ones.\nThey dragged him north, into the hollow."
  },
  {
   "zone": {
    "x0": 12920,
    "z0": 7820,
    "x1": 15980,
    "z1": 9520
   },
   "text": "Old boards over the wet ground. They dragged him straight across them."
  },
  {
   "zone": {
    "x0": 28220,
    "z0": 19890,
    "x1": 30600,
    "z1": 22440
   },
   "text": "Orange paint on the bark. A tree marked for felling.\nThe loggers must be that way."
  }
 ],

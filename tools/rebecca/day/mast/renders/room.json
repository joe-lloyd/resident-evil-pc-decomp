 "checks": [
  {
   "zone": {
    "x0": 5780,
    "z0": 10540,
    "x1": 10200,
    "z1": 13600
   },
   "text": "Engineers' stores. One crate's been forced with a tyre iron.\nTwo first aid boxes, ripped open. The flare case is missing one."
  },
  {
   "zone": {
    "x0": 6800,
    "z0": 13600,
    "x1": 9860,
    "z1": 15640
   },
   "text": "Gauze, wrappers, blood. Somebody patched himself up here, on his knees."
  },
  {
   "zone": {
    "x0": 27030,
    "z0": 11220,
    "x1": 28475,
    "z1": 14280
   },
   "text": "A glove, right at the edge.\nHe's down there on the ledge. Not moving. The crows are on him."
  },
  {
   "zone": {
    "x0": 4080,
    "z0": 10880,
    "x1": 7140,
    "z1": 13600
   },
   "text": "A crow, caught in the guy wire. It flew straight into it."
  },
  {
   "zone": {
    "x0": 15980,
    "z0": 12410,
    "x1": 18020,
    "z1": 13600
   },
   "text": "The gate's open. The padlock chain's been cut.\nDANGER. HIGH VOLTAGE."
  },
  {
   "zone": {
    "x0": 3570,
    "z0": 7140,
    "x1": 7990,
    "z1": 8160
   },
   "text": "ARKLAY TELECOM. AUTHORISED STAFF.\nPadlocked."
  },
  {
   "zone": {
    "x0": 14110,
    "z0": 26010,
    "x1": 15130,
    "z1": 27370
   },
   "text": "A cairn. There's a hand on it, in blood.\nHe came along here, holding himself up."
  },
  {
   "zone": {
    "x0": 15300,
    "z0": 29240,
    "x1": 16320,
    "z1": 30940
   },
   "text": "Straight down, both sides. The crows just hang there in the wind, watching me."
  }
 ],

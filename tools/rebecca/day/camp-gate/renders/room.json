 "entry": null,
 "notes": [
  "from the road coming in: the ruts bending to the gate, the strewn logs, the pickup shoved aside",
  "from beside the gate, looking back down the road: the barricade, the logger, the road into the trees",
  "from the south, square on: the gate and its sign, the gap, the camp beyond"

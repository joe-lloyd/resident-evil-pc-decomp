 "checks": [
  {
   "zone": {
    "x0": 6970,
    "z0": 3400,
    "x1": 10030,
    "z1": 4760
   },
   "text": "KEEP OUT. Painted in a hurry, the paint still running."
  },
  {
   "zone": {
    "x0": 15300,
    "z0": 4420,
    "x1": 19040,
    "z1": 5780
   },
   "text": "ARKLAY TIMBER CO. Someone's clawed the sign.\nThe gate's hanging open."
  },
  {
   "zone": {
    "x0": 18360,
    "z0": 4080,
    "x1": 20400,
    "z1": 6120
   },
   "text": "The outside of the gate is clawed to splinters.\nSomething wanted in."
  },
  {
   "zone": {
    "x0": 8500,
    "z0": 7820,
    "x1": 12920,
    "z1": 10880
   },
   "text": "A logger, face down in the mud. He was running for the road."
  },
  {
   "zone": {
    "x0": 22440,
    "z0": 11220,
    "x1": 25500,
    "z1": 13260
   },
   "text": "The camp truck, shoved out of the gate.\nBloody hands all over the inside of the door. Someone wanted out."
  },
  {
   "zone": {
    "x0": 14280,
    "z0": 6630,
    "x1": 15980,
    "z1": 7820
   },
   "text": "The barricade. Logs off the deck, sandbags, spikes. Pulled down, or pushed."
  },
  {
   "zone": {
    "x0": 1700,
    "z0": 7480,
    "x1": 7820,
    "z1": 8840
   },
   "text": "Logs off the cold deck. They rolled them across the gate."
  }
 ],

  {
   "zone": {
    "x0": 7990,
    "z0": 7480,
    "x1": 10710,
    "z1": 8840
   },
   "text": "NO ENTRY. TURN BACK.\nPainted on a board and nailed up in a hurry."
  },
  {
   "zone": {
    "x0": 21590,
    "z0": 15980,
    "x1": 24990,
    "z1": 17680
   },
   "text": "The driver's door is wide open. Blood on the seat, and down the step.\nScratches on the inside of the door."
  },
  {
   "zone": {
    "x0": 21760,
    "z0": 16490,
    "x1": 24480,
    "z1": 18700
   },
   "text": "His lunch, in the mud. He never got to eat it."
  },
  {
   "zone": {
    "x0": 24990,
    "z0": 16320,
    "x1": 26860,
    "z1": 17850
   },
   "text": "Blood in the mud by the wheel. He was coughing it up."
  },
  {
   "zone": {
    "x0": 26860,
    "z0": 15640,
    "x1": 29920,
    "z1": 17340
   },
   "text": "Bootprints, going east. One foot dragging.\nHe walked toward the camp."
  },
  {
   "zone": {
    "x0": 28050,
    "z0": 11730,
    "x1": 29240,
    "z1": 16150
   },
   "text": "The battery's nearly flat. The blinker's still going.\nThe keys are gone from the ignition."
  },
  {
   "zone": {
    "x0": 5440,
    "z0": 11900,
    "x1": 6800,
    "z1": 15980
   },
   "text": "A full load of logs, for the mill. It never got there."
  }
 ],

  {
   "zone": {
    "x0": 8755,
    "z0": 7905,
    "x1": 11135,
    "z1": 9010
   },
   "text": "A crate. ARKLAY SKYWAY - SPARE. DRIVE COG NO 2.\nThe gondola's spare cog. It's under a pile of logs.\nI can't move those. Not by hand."
  },
  {
   "zone": {
    "x0": 3060,
    "z0": 8670,
    "x1": 6120,
    "z1": 9690
   },
   "text": "Someone slept here. Bandages, black with blood. A tally scratched in the tin: six days.\nA note: \"Bit on the hand Tues. Can't stay. Don't come looking. Gus.\""
  },
  {
   "zone": {
    "x0": 6460,
    "z0": 3230,
    "x1": 8160,
    "z1": 4590
   },
   "text": "A power cable, cut off short. It's still live. I'm not touching that."
  },
  {
   "zone": {
    "x0": 2975,
    "z0": 3910,
    "x1": 3910,
    "z1": 5440
   },
   "text": "A vice, a bench, his tools. The lamp's still on."
  },
  {
   "zone": {
    "x0": 3910,
    "z0": 7225,
    "x1": 5950,
    "z1": 8160
   },
   "text": "An engine, hanging on the hoist chains. Nobody's coming back to finish it."
  },
  {
   "zone": {
    "x0": 3230,
    "z0": 2040,
    "x1": 6120,
    "z1": 3910
   },
   "text": "He barred the door from inside. The bar's been broken.\nFrom this side."
  }
 ],

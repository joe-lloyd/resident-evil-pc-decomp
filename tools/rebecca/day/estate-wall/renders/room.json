  {
   "zone": {
    "x0": 15810,
    "z0": 30770,
    "x1": 18190,
    "z1": 32300
   },
   "text": "The estate's back gate. A chain and a padlock.\nI'll need the key."
  },
  {
   "zone": {
    "x0": 13940,
    "z0": 31110,
    "x1": 15640,
    "z1": 32300
   },
   "text": "NO TRESPASSING. UMBRELLA CORP.\nUmbrella. Out here?"
  },
  {
   "zone": {
    "x0": 15300,
    "z0": 29580,
    "x1": 18020,
    "z1": 30770
   },
   "text": "He tried to climb out over the gate.\nSomething on the other side got his leg first."
  },
  {
   "zone": {
    "x0": 13770,
    "z0": 28390,
    "x1": 15470,
    "z1": 30090
   },
   "text": "His torch. It's still on.\nThe batteries are nearly gone."
  },
  {
   "zone": {
    "x0": 11050,
    "z0": 26520,
    "x1": 14620,
    "z1": 28220
   },
   "text": "A grey uniform cap. Estate security?"
  },
  {
   "zone": {
    "x0": 22780,
    "z0": 2210,
    "x1": 24140,
    "z1": 3740
   },
   "text": "Claw marks, from the glass right down to the ground.\nSomething came over this wall. From the inside."
  },
  {
   "zone": {
    "x0": 21760,
    "z0": 6120,
    "x1": 23120,
    "z1": 7820
   },
   "text": "A shirt, torn on the glass. There's blood on it.\nSomeone tried to get over. Or something dragged them."
  }
 ],

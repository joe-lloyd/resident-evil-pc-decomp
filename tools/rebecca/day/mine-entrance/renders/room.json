   },
   "text": "A gap under the rocks, into the dark. Webs over it.\nThere's blood on the post. Someone squeezed through."
  },
  {
   "zone": {
    "x0": 26350,
    "z0": 14790,
    "x1": 28900,
    "z1": 18700
   },
   "text": "A blasting plunger, pushed home. Whoever fired it\ndropped their hard hat and ran."
  },
  {
   "zone": {
    "x0": 25500,
    "z0": 4250,
    "x1": 27540,
    "z1": 5610
   },
   "text": "SEALED. DO NOT ENTER.\nWhat were they keeping in?"
  },
  {
   "zone": {
    "x0": 25500,
    "z0": 9520,
    "x1": 28560,
    "z1": 12920
   },
   "text": "An ore cart, tipped over. Silver ore, dull and grey."
  },
  {
   "zone": {
    "x0": 4590,
    "z0": 11220,
    "x1": 7310,
    "z1": 12665
   },
   "text": "Another cart, on its side on the trestle.\nThe web runs from it right down into the ravine."
  },
  {
   "zone": {
    "x0": 2295,
    "z0": 10200,
    "x1": 4080,
    "z1": 11220
   },
   "text": "The trestle creaks. It's a long way down."
  }

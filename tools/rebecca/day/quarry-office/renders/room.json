   "text": "A steel locker, stencilled EXPLOSIVES. KEEP LOCKED.\nIt's padlocked."
  },
  {
   "zone": {
    "x0": 1700,
    "z0": 2550,
    "x1": 3060,
    "z1": 4080
   },
   "text": "A box marked CAPS, and coils of wire. Blasting caps.\nKept well away from the locker."
  },
  {
   "zone": {
    "x0": 2040,
    "z0": 1700,
    "x1": 3825,
    "z1": 2720
   },
   "text": "The time clock is still ticking. The second hand's stuck,\njumping on the same mark over and over."
  },
  {
   "zone": {
    "x0": 5270,
    "z0": 3060,
    "x1": 6324,
    "z1": 4250
   },
   "text": "The foreman's report, half written. The last line just stops."
  },
  {
   "zone": {
    "x0": 5270,
    "z0": 4250,
    "x1": 6324,
    "z1": 5440
   },
   "text": "The shift rosters. Name after name crossed out in red. SICK.\nBy the last one there's hardly anyone left."
  },
  {
   "zone": {
    "x0": 6120,
    "z0": 5270,
    "x1": 7480,
    "z1": 6460
   },
   "text": "The coffee's been on the hot plate for days. It's burnt to tar."
  },
  {
   "zone": {
    "x0": 3570,
    "z0": 5610,
    "x1": 5270,
    "z1": 6460
   },
   "text": "DAYS WITHOUT AN ACCIDENT. Someone wiped the number off\nand wrote a 0."
  }

 "checks": [
  {
   "zone": {
    "x0": 10540,
    "z0": 14280,
    "x1": 12920,
    "z1": 15980
   },
   "text": "Kevin. He's still belted into his seat.\nHe flew us out here. He stayed with it."
  },
  {
   "zone": {
    "x0": 14280,
    "z0": 14280,
    "x1": 17000,
    "z1": 15640
   },
   "text": "The cargo bay. Rope, a box of flares...\nA crowbar on the floor."
  },
  {
   "zone": {
    "x0": 11560,
    "z0": 16830,
    "x1": 14280,
    "z1": 18530
   },
   "text": "Someone patched themselves up here.\nThe medkit's empty. The gauze is soaked."
  },
  {
   "zone": {
    "x0": 14790,
    "z0": 15640,
    "x1": 19550,
    "z1": 18530
   },
   "text": "Our cases. Somebody took what they could carry."
  },
  {
   "zone": {
    "x0": 9520,
    "z0": 15300,
    "x1": 11560,
    "z1": 16830
   },
   "text": "The field radio. Someone's smashed it.\nOr dropped it, trying."
  },
  {
   "zone": {
    "x0": 20570,
    "z0": 6800,
    "x1": 25670,
    "z1": 11220
   },
   "text": "The tail broke clean off when she came down."
  },
  {
   "zone": {
    "x0": 18700,
    "z0": 18870,
    "x1": 20400,
    "z1": 20570
   },
   "text": "A flare, burnt down to nothing.\nThey were signalling. Nobody came."
  },
  {
   "zone": {
    "x0": 22270,
    "z0": 12410,
    "x1": 25500,
    "z1": 15810
   },
   "text": "Boot prints in the mud, heading east.\nThe others walked out."
  },
  {
   "zone": {
    "x0": 29750,
    "z0": 12920,
    "x1": 31620,
    "z1": 13940
   },
   "text": "A rotor blade, buried in that trunk.\nIf anyone had been standing here..."
  },
  {
   "zone": {
    "x0": 26860,
    "z0": 14280,
    "x1": 29240,
    "z1": 15300
   },
   "text": "The trees are snapped off and burnt black, all the way along.\nShe spun before she came down."
  }
 ],
 "saves": null,

 "notes": [
  "from the valley path: the cabin's open side, the tail, the boot prints going out",
  "from the snapped spruces: the furrow, the nose, the kit scattered beyond",
  "from the south-west: the open pilot's door, Kevin in his seat, the medkit",
  "close on the cockpit: Kevin belted in, the starred windshield",
  "from the south-east: the cargo bay, the cases, the flare, the smoke",
  "from the north-east by the tail: the bent rotor, the north side and the clearing south",
  "from the clearing's south-east: into the burnt swath, the snapped trunks, the blade sunk in one",
  "from the swath's far end: back through the burnt trunks to the helicopter in the clearing"
 ]
}
 "notes": [
  "high in the north-west corner: the log on the carriage, the blade, the blood on the boards",
  "high in the south-east corner: the board stack's bloody face, the saw, the big doors far off",
  "high in the north-east corner: the turning pulley, the slack belt, the crane, the mill's length",
  "high in the south-west corner: the big doors, the edger, the back door far off",
  "close on the head saw: the blade, the arm in the sawdust",
  "from by the back door: down the mill to the big doors and the yard",
  "from past the pond gate, back along the walk: the race, the tailer turning in it, the wheel, the back door",
  "from over the race by the wheel: the tailer below, the plank walk, the pond gate"
 ]
}
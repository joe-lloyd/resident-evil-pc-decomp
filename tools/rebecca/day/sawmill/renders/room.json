 "checks": [
  {
   "zone": {
    "x0": 12920,
    "z0": 11900,
    "x1": 17340,
    "z1": 13260
   },
   "text": "An arm, in a plaid sleeve. Torn off at the elbow.\nThe sawdust round it is soaked through."
  },
  {
   "zone": {
    "x0": 13940,
    "z0": 12070,
    "x1": 20740,
    "z1": 13260
   },
   "text": "Blood, thrown across the boards in a long fan.\nThe saw was running when it happened."
  },
  {
   "zone": {
    "x0": 11900,
    "z0": 11220,
    "x1": 13600,
    "z1": 12240
   },
   "text": "The head saw. There's still a log on the carriage, half cut.\nSomeone threw the belt off to stop the blade."
  },
  {
   "zone": {
    "x0": 19720,
    "z0": 8840,
    "x1": 23120,
    "z1": 10540
   },
   "text": "The water wheel's shaft. The belt to the saw's been thrown off.\nThe line shaft for the crane is still belted to it."
  },
  {
   "zone": {
    "x0": 22100,
    "z0": 15470,
    "x1": 23800,
    "z1": 16320
   },
   "text": "A bloody hand on the back door's frame.\nHe went out this way."
  },
  {
   "zone": {
    "x0": 10880,
    "z0": 19720,
    "x1": 12920,
    "z1": 20740
   },
   "text": "Board feet cut: Monday 4100. Tuesday 3850. Wednesday 1200.\nThen nothing."
  },
  {
   "zone": {
    "x0": 28900,
    "z0": 14620,
    "x1": 31620,
    "z1": 15640
   },
   "text": "Somebody's in the race. Face down, going round and round in the eddy.\nThe tailer. He worked the boards off the saw."
  },
  {
   "zone": {
    "x0": 24735,
    "z0": 15640,
    "x1": 27200,
    "z1": 16660
   },
   "text": "The water wheel. The race turns it, when the pond's sluice is open."
  },
  {
   "zone": {
    "x0": 30260,
    "z0": 17340,
    "x1": 31280,
    "z1": 18360
   },
   "text": "The sawyer's blood, all along the planks.\nHe was going for the pond."
  }
 ],
